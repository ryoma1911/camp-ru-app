# Supabase: Project Settings → API Keys
# このファイルを .env.local にコピーして値を入れてください（.env.local は git に含まれません）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# 新しい「Publishable key」(sb_publishable_...) か、従来の「anon key」のどちらでも可
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 公開するサイトのURL（Xなどで共有したときのカード画像のURLに使う）。手元では未設定で http://localhost:3000
NEXT_PUBLIC_SITE_URL=
